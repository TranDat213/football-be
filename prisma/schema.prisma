generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum FieldStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum YardStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingSource {
  ONLINE
  OFFLINE
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  OWNER_CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  REFUND_PENDING
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  CASH
  MOMO
  VNPAY
  BANK_TRANSFER
}

enum CasualMatchStatus {
  OPEN // accepting participants
  FULL // all slots taken
  CLOSED // host closed manually
  CANCELLED // booking cancelled → cascade
  STARTED // match in progress
  FINISHED // match ended
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum TeamMode {
  NO_TEAM
  OPTIONAL_TEAM
  REQUIRED_TEAM
}

enum TeamSide {
  TEAM_A
  TEAM_B
}

enum JoinStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WAITLISTED // future: waiting list
}

enum ParticipantPayStatus {
  UNPAID
  PAID
  REFUNDED
  REFUND_PENDING
}

enum SkillLevel {
  ANY
  BEGINNER
  INTERMEDIATE
  PRO
}

enum YardType {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

enum NotificationType {
  OWNER_REGISTER_APPROVED
  FIELD_APPROVED
  FIELD_CREATED_APPROVED
  BOOKING_CREATED
  BOOKING_CANCELLED
  CASUAL_MATCH_JOINED
  CASUAL_MATCH_LEAVED
  FIELD_WAITING_APPROVAL
  FIELD_UPDATE_WAITING
  OWNER_REGISTER_WAITING
  OWNER_CANCEL_BOOKING
  OFFLINE_BOOKING_UNLOCK   // Cron gửi khi mở khoá offline booking
  OFFLINE_ARRIVAL_CONFIRM  // Sau confirm-arrival hoặc reclaim thành công
}

enum OwnerRegistrationStatus {
  PENDING
  CONTACTING
  APPROVED
  REJECTED
}

enum ProviderType {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum TimeSlotLabel {
  REGULAR
  PEAK
  LATE_NIGHT
}

enum FootballFieldUpdateRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ─────────────────────────────────────────
// DOMAIN: USERS
// ─────────────────────────────────────────

model User {
  id             String        @id @default(uuid())
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  username       String        @unique @map("username") @db.VarChar(100)
  email          String        @unique @db.VarChar(255)
  password       String?       @db.Text
  phone          String?       @unique @db.VarChar(20)
  avatarUrl      String?       @map("avatar_url") @db.Text
  avatarPublicId String?       @map("avatar_public_id") @db.VarChar(255)
  role           UserRole      @default(USER)
  status         UserStatus    @default(ACTIVE)
  provider       ProviderType? @default(LOCAL)
  providerId     String?       @map("provider_id") @db.VarChar(255)
  lastLoginAt    DateTime?     @map("last_login_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  // Relations
  footballFields        FootballField[]
  bookings              Booking[]
  casualMatches         CasualMatch[]
  casualParticipations  CasualMatchParticipant[]
  sentNotifications     Notification[]               @relation("NotificationActor")
  receivedNotifications Notification[]               @relation("NotificationRecipient")
  ownerRegistration     OwnerRegistration[]
  updateRequests        FootballFieldUpdateRequest[]
  reviewedRequests      FootballFieldUpdateRequest[] @relation("Reviewer")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────
// DOMAIN: FOOTBALL FIELDS
// ─────────────────────────────────────────

model FieldCategory {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  slug         String    @unique @db.VarChar(120)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  footballFields FootballField[]

  @@map("field_categories")
}

model FootballField {
  id          String      @id @default(uuid())
  ownerId     String      @map("owner_id")
  categoryId  String?     @map("category_id")
  name        String      @db.VarChar(255)
  slug        String      @unique @db.VarChar(300)
  description String?     @db.Text
  address     String      @db.Text
  province    String      @db.VarChar(100)
  district    String      @db.VarChar(100)
  ward        String?     @db.VarChar(100)
  latitude    Decimal?    @db.Decimal(10, 8)
  longitude   Decimal?    @db.Decimal(11, 8)
  openTime    DateTime?   @map("open_time") @db.Time
  closeTime   DateTime?   @map("close_time") @db.Time
  status      FieldStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  owner          User                         @relation(fields: [ownerId], references: [id])
  category       FieldCategory?               @relation(fields: [categoryId], references: [id])
  yards          FieldYard[]
  images         FieldImage[]
  updateRequests FootballFieldUpdateRequest[]
  // ponytail: matchPosts removed; browse via Booking → CasualMatch

  @@index([ownerId, status])
  @@index([province, district])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@map("football_fields")
}

model FootballFieldUpdateRequest {
  id              String                           @id @default(uuid())
  footballFieldId String                           @map("football_field_id")
  ownerId         String                           @map("owner_id")
  payload         Json
  status          FootballFieldUpdateRequestStatus @default(PENDING)
  reason          String?                          @db.Text
  reviewedBy      String?                          @map("reviewed_by")
  reviewedAt      DateTime?                        @map("reviewed_at")
  createdAt       DateTime                         @default(now()) @map("created_at")
  updatedAt       DateTime                         @updatedAt @map("updated_at")
  deletedAt       DateTime?                        @map("deleted_at")

  footballField FootballField @relation(fields: [footballFieldId], references: [id])
  owner         User          @relation(fields: [ownerId], references: [id])
  reviewer      User?         @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([footballFieldId, status])
  @@map("football_field_update_requests")
}

model FieldYard {
  id              String     @id @default(uuid())
  footballFieldId String     @map("football_field_id")
  name            String     @db.VarChar(100)
  code            String     @db.VarChar(20)
  type            YardType   @default(FIVE_A_SIDE)
  status          YardStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  footballField FootballField   @relation(fields: [footballFieldId], references: [id])
  timeSlots     FieldTimeSlot[]
  bookings      Booking[]

  @@index([footballFieldId])
  @@map("field_yards")
}

model FieldImage {
  id              String    @id @default(uuid())
  footballFieldId String    @map("football_field_id")
  url             String    @db.Text
  publicId        String?   @map("public_id") @db.VarChar(255)
  isCover         Boolean   @default(false) @map("is_cover")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  footballField FootballField @relation(fields: [footballFieldId], references: [id])

  @@index([footballFieldId, sortOrder])
  @@map("field_images")
}

model FieldTimeSlot {
  id          String        @id @default(uuid())
  fieldYardId String        @map("field_yard_id")
  dayOfWeek   Int           @map("day_of_week") @db.SmallInt
  startTime   DateTime      @map("start_time") @db.Time
  endTime     DateTime      @map("end_time") @db.Time
  label       TimeSlotLabel @default(REGULAR)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  fieldYard FieldYard       @relation(fields: [fieldYardId], references: [id])
  priceRule FieldPriceRule?

  @@index([fieldYardId, dayOfWeek])
  @@map("field_time_slots")
}

model FieldPriceRule {
  id         String    @id @default(uuid())
  timeSlotId String    @unique @map("time_slot_id")
  price      Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  timeSlot FieldTimeSlot @relation(fields: [timeSlotId], references: [id])

  @@index([timeSlotId])
  @@map("field_price_rules")
}

// ─────────────────────────────────────────
// DOMAIN: BOOKINGS & PAYMENTS
// ─────────────────────────────────────────

model Booking {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  fieldYardId       String        @map("field_yard_id")
  bookingDate       DateTime      @map("booking_date") @db.Date
  startTime         DateTime      @map("start_time") @db.Time
  endTime           DateTime      @map("end_time") @db.Time
  totalPrice        Decimal       @map("total_price") @db.Decimal(12, 2)
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  source            BookingSource @default(ONLINE) @map("source")
  note              String?       @db.Text
  expiresAt            DateTime?     @map("expires_at")
  customerArrivedAt    DateTime?     @map("customer_arrived_at") // Offline: null=chưa confirm | set=đã confirm/reclaim
  cancelledAt          DateTime?     @map("cancelled_at")
  cancelledReason      String?       @map("cancelled_reason") @db.Text
  ownerCancelReason    String?       @map("owner_cancel_reason") @db.Text
  ownerCancelledAt     DateTime?     @map("owner_cancelled_at")
  ownerCancelledBy     String?       @map("owner_cancelled_by") @db.VarChar(255)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  user        User         @relation(fields: [userId], references: [id])
  fieldYard   FieldYard    @relation(fields: [fieldYardId], references: [id])
  payment     Payment?
  commission  Commission?
  refund      Refund?
  casualMatch CasualMatch?

  @@index([fieldYardId, bookingDate, startTime, endTime])
  @@index([userId, status])
  @@index([bookingDate, status])
  @@index([status, expiresAt])
  @@map("bookings")
}

model Commission {
  id         String   @id @default(uuid())
  bookingId  String   @unique @map("booking_id")
  amount     Decimal  @db.Decimal(12, 2)
  percentage Float    @default(10.0)
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("commissions")
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique @map("booking_id")
  transactionCode String?       @unique @map("transaction_code") @db.VarChar(100)
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(UNPAID)
  paidAt          DateTime?     @map("paid_at")
  gatewayResponse Json?         @map("gateway_response") @db.JsonB
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  refund  Refund?

  @@map("payments")
}

model Refund {
  id          String       @id @default(uuid())
  bookingId   String       @unique @map("booking_id")
  paymentId   String?      @unique @map("payment_id")
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?      @db.Text
  status      RefundStatus @default(PENDING)
  processedAt DateTime?    @map("processed_at")
  adminNote   String?      @map("admin_note") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

// ─────────────────────────────────────────
// DOMAIN: CASUAL MATCH (Đặt vãng lai)
// ─────────────────────────────────────────

/// A published casual booking.
/// Booking is the SINGLE SOURCE OF TRUTH for:
///   field, yard, date, startTime, endTime, owner, bookingStatus, payment.
/// CasualMatch stores ONLY community-specific metadata.
model CasualMatch {
  id             String            @id @default(uuid())
  bookingId      String            @unique @map("booking_id") // 1-to-1; booking owns the slot
  hostId         String            @map("host_id") // denorm of booking.userId for fast query
  title          String?           @db.VarChar(255)
  description    String?           @db.Text
  totalSlots     Int               @map("total_slots") // max participants host wants
  availableSlots Int               @map("available_slots") // totalSlots - occupiedSlots, updated on join/cancel
  occupiedSlots  Int               @default(0) @map("occupied_slots")
  slotPrice      Decimal           @map("slot_price") @db.Decimal(12, 2)
  skillLevel     SkillLevel        @default(ANY) @map("skill_level")
  visibility     Visibility        @default(PUBLIC)
  status         CasualMatchStatus @default(OPEN)
  teamMode       TeamMode          @default(NO_TEAM) @map("team_mode")
  joinDeadline   DateTime?         @map("join_deadline") // null = close when FULL or host closes
  startedAt      DateTime?         @map("started_at") // future: check-in / match started
  finishedAt     DateTime?         @map("finished_at") // future: match finished
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  booking      Booking                  @relation(fields: [bookingId], references: [id])
  host         User                     @relation(fields: [hostId], references: [id])
  participants CasualMatchParticipant[]

  // Browse: filter by field/location/date → join via Booking
  @@index([status, visibility])
  // Fast lookup of host's posts
  @@index([hostId, status])
  // Soft-delete filter
  @@index([deletedAt])
  @@map("casual_matches")
}

/// A reserved slot inside a CasualMatch.
/// One participant row may reserve multiple slots (slotCount > 1).
model CasualMatchParticipant {
  id              String               @id @default(uuid())
  casualMatchId   String               @map("casual_match_id")
  userId          String               @map("user_id")
  slotCount       Int                  @default(1) @map("slot_count") // how many slots this participant takes
  unitPrice       Decimal              @map("unit_price") @db.Decimal(12, 2) // snapshot of slotPrice at join time
  totalAmount     Decimal              @map("total_amount") @db.Decimal(12, 2) // slotCount * unitPrice
  paymentStatus   ParticipantPayStatus @default(UNPAID) @map("payment_status")
  joinStatus      JoinStatus           @default(PENDING) @map("join_status")
  selectedTeam    TeamSide?            @map("selected_team")
  joinedAt        DateTime?            @map("joined_at") // set when APPROVED
  cancelledAt     DateTime?            @map("cancelled_at") // future: cancellation tracking
  reservedUntil   DateTime?            @map("reserved_until") // future: reservation timeout / waitlist expiry
  checkedInAt     DateTime?            @map("checked_in_at") // future: check-in
  transactionCode String?              @unique @map("transaction_code") @db.VarChar(100) // VNPay transaction no
  gatewayResponse Json?                @map("gateway_response") @db.JsonB // full VNPay IPN params
  paidAt          DateTime?            @map("paid_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  casualMatch CasualMatch @relation(fields: [casualMatchId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  // Prevent double-join: one row per (match, user)
  @@unique([casualMatchId, userId])
  // Query participants of a match by status
  @@index([casualMatchId, joinStatus])
  // Query a user's participations
  @@index([userId, joinStatus])
  // Timeout job: find expired reservations efficiently
  @@index([reservedUntil])
  @@map("casual_match_participants")
}

// ─────────────────────────────────────────
// DOMAIN: NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  entityType  String           @map("entity_type") @db.VarChar(50)
  entityId    String           @map("entity_id") @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  content     String?          @db.Text
  metadata    Json?            @db.JsonB
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("notifications")
}

model OwnerRegistration {
  id String @id @default(uuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)
  email     String
  phone     String

  stadiumName String? @map("stadium_name")
  address     String?

  status OwnerRegistrationStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("owner_registrations")
}

// ─────────────────────────────────────────
// DOMAIN: RAG / DOCUMENTS
// ─────────────────────────────────────────

model SystemDocument {
  id        String                       @id @default(uuid())
  title     String                       @db.VarChar(255)
  content   String                       @db.Text
  category  String                       @db.VarChar(100)
  embedding Unsupported("vector(3072)")?
  metadata  Json?                        @db.JsonB
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  @@map("system_documents")
}
