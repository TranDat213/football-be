# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Domain / CORS ───────────────────────────────────────────
# URL của Frontend (dùng để cấu hình CORS)
CLIENT_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────
# Local (Docker Compose): port 5433 để tránh xung đột PostgreSQL cài sẵn
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/football_db
# ── JWT ─────────────────────────────────────────────────────
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookie ──────────────────────────────────────────────────
COOKIE_MAX_AGE=7d
COOKIE_REFRESH_MAX_AGE=30d

# ── Cloudinary (lưu trữ ảnh) ────────────────────────────────
# Đăng ký tại: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ── Resend (gửi email) ──────────────────────────────────────
# Đăng ký tại: https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=onboarding@resend.dev

# ── OTP ─────────────────────────────────────────────────────
OTP_EXPIRES=60000
OTP_COOLDOWN=60000
OTP_RESET_TOKEN=1800000

# ── Email Verification ──────────────────────────────────────
EMAIL_VERIFY_SECRET=your_email_verify_secret_here
EMAIL_VERIFY_EXPIRES=24h
EMAIL_PWD_CHANGE_EXPIRES=1h

# ── Slug ────────────────────────────────────────────────────
MAX_SLUG_LENGTH=60

# ── Google OAuth ────────────────────────────────────────────
# Tạo credentials tại: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ── VNPay (thanh toán) ──────────────────────────────────────
# Đăng ký tại: https://sandbox.vnpayment.vn/devreg
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/result
# IPN URL cần public endpoint - dùng ngrok: ngrok http 5000
VNP_IPN_URL=https://your-ngrok-url.ngrok-free.app/api/payments/vnpay/ipn

# ── Google Gemini AI (chatbot) ───────────────────────────────
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# ── Booking Lock ────────────────────────────────────────────
# Thời gian giữ khóa booking (ms) - mặc định 15 phút
LOCK_TTL_MINUTES=900000
# Thời gian cutoff booking (ms) - mặc định 60 phút
CUTOFF_MINUTES=3600000
